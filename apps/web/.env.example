# ------------------------------------------------------------------
# Variables de entorno de la app web (obligatorias para el arranque).
# Todas las variables NEXT_PUBLIC_* se exponen al bundle de cliente.
# No colocar secretos aquí.
# ------------------------------------------------------------------

# (REQUERIDA) URL base de la API NestJS consumida por la web.
# Formato: http(s)://host[:puerto]
NEXT_PUBLIC_API_URL=http://localhost:4000

# (OPCIONAL) Entorno de ejecución. Valores válidos:
# development | test | staging | production. Default: development.
# NEXT_PUBLIC_APP_ENVIRONMENT=development
