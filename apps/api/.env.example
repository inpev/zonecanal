# ------------------------------------------------------------------
# Variables de entorno de la API (opcionales, con defaults locales).
# No colocar secretos aquí.
# ------------------------------------------------------------------

# (OPCIONAL) Puerto HTTP de la API NestJS.
# Formato: entero entre 1 y 65535. Default: 4000.
PORT=4000

# (OPCIONAL) Orígenes permitidos por CORS, separados por coma.
# Formato: lista de URLs http(s). Default: http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
